{
  "name": "cloudflare-search-portal",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "astro dev --host",
    "start": "astro dev --host",
    "build": "astro build",
    "check": "astro check",
    "test": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:migrations": "./scripts/test-migrations.sh",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run audit && npm run check && npm test && npm run test:security && npm run test:migrations && npm run build",
    "configure:cloudflare": "node scripts/configure-cloudflare.mjs --write",
    "contract:audit": "./scripts/reconcile.sh --no-fetch",
    "verify:production": "./scripts/verify-production.sh",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "./scripts/verify-production.sh --production --skip-install && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.1",
    "@starwind-ui/astro": "1.1.0",
    "@tailwindcss/forms": "0.5.11",
    "astro": "7.2.2",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260816.1",
    "@tailwindcss/vite": "4.3.3",
    "starwind": "3.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
