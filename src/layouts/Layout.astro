---
import { Search } from '@lucide/astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Unified AI Search Portal" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-[#Fdfdfc] text-[#1c1c1c] min-h-screen relative font-sans selection:bg-[#1c1c1c] selection:text-[#Fdfdfc] antialiased flex flex-col">
		
		<!-- Distinct, bespoke architectural grid -->
		<div class="fixed inset-0 z-[-1] h-full w-full bg-[#Fdfdfc] bg-[linear-gradient(to_right,#f0f0f0_1px,transparent_1px),linear-gradient(to_bottom,#f0f0f0_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
		
		<nav class="absolute top-0 w-full z-10 p-8 flex items-center justify-between pointer-events-none">
			<div class="flex items-center gap-3 font-semibold text-[0.8rem] tracking-[0.2em] uppercase text-[#1c1c1c]">
				<div class="w-2 h-2 bg-[#1c1c1c] rounded-full"></div>
				<span>Nexus</span>
			</div>
		</nav>

		<main class="flex-1 w-full max-w-5xl mx-auto px-6 py-12 flex flex-col justify-center">
			<slot />
		</main>
		
	</body>
</html>

<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;
</style>
