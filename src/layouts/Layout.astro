---
import { Home, Sparkles } from '@lucide/astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Unified AI Search Portal" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-[#131314] text-gray-100 min-h-screen relative font-sans selection:bg-blue-500 selection:text-white antialiased flex flex-col">
		
		<!-- Masterfully faded dark background texture (vignette effect) -->
		<div class="fixed inset-0 z-[-1] h-full w-full bg-[#131314] bg-[radial-gradient(#2a2b2c_1.5px,transparent_1.5px)] [background-size:24px_24px] [mask-image:radial-gradient(ellipse_70%_70%_at_50%_50%,#000_10%,transparent_100%)]"></div>
		
		<!-- Top Right Home Button (From Reference Image) -->
		<div class="fixed top-8 right-8 z-50">
			<a href="/" class="w-16 h-16 bg-[#3b82f6] hover:bg-[#60a5fa] text-[#0f172a] rounded-full flex items-center justify-center shadow-lg transition-transform active:scale-95">
				<Home class="w-8 h-8" />
			</a>
		</div>

		<main class="flex-1 w-full max-w-5xl mx-auto px-6 py-12 flex flex-col">
			<slot />
		</main>
		
		<!-- Bottom Right Sparkle (From Reference Image) -->
		<div class="fixed bottom-10 right-10 z-0 opacity-40">
			<Sparkles class="w-8 h-8 text-gray-400" />
		</div>
	</body>
</html>

<style is:global>
	@tailwind base;
	@tailwind components;
	@tailwind utilities;
</style>
