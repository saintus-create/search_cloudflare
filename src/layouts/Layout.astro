---
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="CloudSearch — evidence-grounded document search." />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <script is:inline>
      const savedTheme = localStorage.getItem('cloudsearch-theme');
      if (savedTheme === 'dark' || (!savedTheme && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
    </script>
    <div class="min-h-screen">
      <slot />
    </div>
    <script>
      import '../scripts/upload-automation';
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/starwind.css';
</style>
