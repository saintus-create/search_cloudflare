---
import Layout from '../layouts/Layout.astro';
import HeroSearch from '../components/HeroSearch';
---

<Layout title="wikipedia">
	<div class="flex flex-col w-full h-full min-h-[100dvh] pt-12 relative">
		
		<!-- Header (Logo & Menu) -->
		<div class="w-full px-8 flex items-center justify-between z-20">
			<!-- Two horizontal bars -->
			<div class="flex flex-col gap-1.5 cursor-pointer">
				<div class="w-5 h-[2px] bg-black"></div>
				<div class="w-5 h-[2px] bg-black"></div>
			</div>
			<!-- Logo -->
			<div class="font-bold text-lg tracking-tighter">wikipedia</div>
		</div>

		<!-- Search Component -->
		<HeroSearch client:load />

	</div>
</Layout>
