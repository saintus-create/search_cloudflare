---
import Layout from '../layouts/Layout.astro';
import { Search, Send, Globe, Loader2, Sparkles, Database, Link2 } from '@lucide/astro';
---

<Layout title="CloudSearch - Unified AI Portal">
	<div class="flex flex-col items-center justify-center min-h-[60vh] space-y-12">
		<!-- Hero / Search Section -->
		<section class="w-full text-center space-y-8">
			<h1 class="text-4xl font-light tracking-tight text-black sm:text-5xl">
				What are you looking for?
			</h1>
			
			<div class="max-w-2xl mx-auto relative group w-full">
				<form id="omnibar-form" class="relative flex items-center">
					<div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
						<Search class="h-5 w-5 text-gray-400 group-focus-within:gradient-icon transition-colors" />
					</div>
					<input 
						type="text" 
						id="omnibar-input"
						autocomplete="off"
						placeholder="Ask, search, or enter a URL..." 
						class="block w-full pl-14 pr-16 py-5 bg-white text-black border border-gray-200 rounded-full shadow-sm hover:shadow-md focus:shadow-md focus:ring-0 focus:border-gray-300 outline-none transition-all text-lg font-light placeholder:text-gray-400"
					/>
					<button 
						type="submit"
						class="absolute inset-y-2 right-2 px-4 bg-black hover:bg-gray-800 text-white rounded-full flex items-center justify-center transition-colors"
					>
						<Send class="w-4 h-4" />
					</button>
				</form>
			</div>
		</section>

		<!-- Unified Results Area -->
		<div id="unified-container" class="w-full max-w-3xl space-y-12 hidden text-left">
			
			<!-- Crawl Action UI -->
			<div id="crawl-action-ui" class="bg-gray-50 border border-gray-100 p-6 rounded-3xl hidden flex-col sm:flex-row items-center justify-between gap-4">
				<div class="flex items-center gap-4">
					<div class="p-3 bg-white rounded-full shadow-sm">
						<Globe class="w-6 h-6 gradient-icon" />
					</div>
					<div>
						<h3 class="font-medium text-black">Link detected</h3>
						<p class="text-gray-500 text-sm font-light mt-1">Would you like to index this page?</p>
					</div>
				</div>
				<button id="crawl-confirm-btn" class="px-6 py-2.5 bg-black text-white text-sm font-medium rounded-full hover:bg-gray-800 transition-colors flex items-center gap-2">
					<span id="crawl-btn-text">Index Link</span>
					<Loader2 id="crawl-loader" class="w-4 h-4 animate-spin hidden" />
				</button>
				<p id="crawl-status" class="text-sm font-medium hidden"></p>
			</div>

			<!-- AI Answer Area -->
			<div id="ai-answer-container" class="hidden space-y-4">
				<div class="flex items-center gap-2">
					<Sparkles class="w-5 h-5 gradient-icon" />
					<h2 class="text-sm font-medium text-gray-500 uppercase tracking-widest">AI Response</h2>
				</div>
				<div id="ai-answer-content" class="text-black font-light text-lg leading-relaxed prose prose-p:my-4">
					<p class="text-gray-400 italic animate-pulse flex items-center gap-3">
						<Loader2 class="w-5 h-5 animate-spin" /> Synthesizing...
					</p>
				</div>
			</div>

			<!-- Search Results Area -->
			<div id="search-results-container" class="hidden space-y-4 pt-8 border-t border-gray-100">
				<div class="flex items-center gap-2 mb-6">
					<Database class="w-4 h-4 text-gray-400" />
					<h2 class="text-sm font-medium text-gray-400 uppercase tracking-widest">Sources</h2>
				</div>
				<div id="search-results-list" class="grid gap-6">
					<!-- Results go here -->
				</div>
			</div>

		</div>
	</div>

	<script>
		const form = document.getElementById('omnibar-form');
		const input = document.getElementById('omnibar-input');
		const unifiedContainer = document.getElementById('unified-container');
		
		const crawlActionUi = document.getElementById('crawl-action-ui');
		const crawlConfirmBtn = document.getElementById('crawl-confirm-btn');
		const crawlBtnText = document.getElementById('crawl-btn-text');
		const crawlLoader = document.getElementById('crawl-loader');
		const crawlStatus = document.getElementById('crawl-status');
		
		const aiContainer = document.getElementById('ai-answer-container');
		const aiContent = document.getElementById('ai-answer-content');
		
		const searchContainer = document.getElementById('search-results-container');
		const searchList = document.getElementById('search-results-list');

		let currentCrawlUrl = '';

		const isUrl = (text) => {
			try {
				const url = new URL(text);
				return url.protocol === 'http:' || url.protocol === 'https:';
			} catch {
				return false;
			}
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const query = input.value.trim();
			if (!query) return;

			unifiedContainer.classList.remove('hidden');

			if (isUrl(query)) {
				crawlActionUi.classList.remove('hidden');
				aiContainer.classList.add('hidden');
				searchContainer.classList.add('hidden');
				
				currentCrawlUrl = query;
				crawlConfirmBtn.classList.remove('hidden');
				crawlConfirmBtn.disabled = false;
				crawlStatus.classList.add('hidden');
				crawlStatus.textContent = '';
				crawlBtnText.textContent = 'Index Link';
			} else {
				crawlActionUi.classList.add('hidden');
				aiContainer.classList.remove('hidden');
				searchContainer.classList.remove('hidden');

				aiContent.innerHTML = `<p class="text-gray-400 italic animate-pulse flex items-center gap-3">
					<svg class="w-5 h-5 animate-spin lucide lucide-loader-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg> 
					Synthesizing...
				</p>`;
				searchList.innerHTML = `<div class="text-gray-400 italic animate-pulse font-light">Retrieving documents...</div>`;

				fetch('/api/chat', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ message: query })
				})
				.then(res => res.json())
				.then(data => {
					if (data.answer) {
						aiContent.innerHTML = `<p>${data.answer.replace(/\n/g, '<br/>')}</p>`;
					} else {
						aiContent.innerHTML = `<p class="text-gray-500 italic">No response generated.</p>`;
					}
				})
				.catch(err => {
					aiContent.innerHTML = `<p class="text-gray-500 italic">Error connecting to AI: ${err.message}</p>`;
				});

				fetch(`/api/search?q=${encodeURIComponent(query)}`)
				.then(res => res.json())
				.then(data => {
					const results = data.results || [];
					if (results.length > 0) {
						searchList.innerHTML = results.map(r => `
							<div class="group cursor-pointer">
								<a href="${r.url}" target="_blank" class="text-black font-medium group-hover:underline block mb-1 text-lg">${r.title}</a>
								<p class="text-sm text-gray-500 font-light leading-relaxed mb-2">${r.snippet}</p>
								<span class="text-xs text-gray-400 flex items-center gap-1.5 uppercase tracking-wider">
									<svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
									${r.url}
								</span>
							</div>
						`).join('');
					} else {
						searchList.innerHTML = `<p class="text-gray-400 italic font-light">No matching documents found.</p>`;
					}
				})
				.catch(err => {
					searchList.innerHTML = `<p class="text-gray-400 italic font-light">Search error: ${err.message}</p>`;
				});
			}
		});

		crawlConfirmBtn.addEventListener('click', async () => {
			if (!currentCrawlUrl) return;

			crawlConfirmBtn.disabled = true;
			crawlLoader.classList.remove('hidden');
			crawlBtnText.textContent = 'Indexing...';
			
			crawlStatus.classList.remove('hidden');
			crawlStatus.textContent = 'Extracting content...';
			crawlStatus.className = 'text-sm font-medium text-gray-500 animate-pulse';

			try {
				const res = await fetch('/api/crawl', {
					method: 'POST',
					body: JSON.stringify({ url: currentCrawlUrl }),
					headers: { 'Content-Type': 'application/json' }
				});
				const data = await res.json();
				
				crawlLoader.classList.add('hidden');
				crawlConfirmBtn.classList.add('hidden');

				if (data.success) {
					crawlStatus.textContent = `Indexed: ${data.title}`;
					crawlStatus.className = 'text-sm font-medium text-black';
					setTimeout(() => {
						input.value = '';
					}, 2000);
				} else {
					throw new Error(data.error || 'Failed to crawl');
				}
			} catch (err) {
				crawlLoader.classList.add('hidden');
				crawlConfirmBtn.disabled = false;
				crawlBtnText.textContent = 'Retry';
				
				crawlStatus.textContent = `Error: ${err.message}`;
				crawlStatus.className = 'text-sm font-medium text-red-500';
			}
		});
	</script>
</Layout>
