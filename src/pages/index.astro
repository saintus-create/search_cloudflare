---
import Layout from '../layouts/Layout.astro';
import { Search, Send, Globe, Loader2, Bot, Database } from '@lucide/astro';
---

<Layout title="CloudSearch - Unified AI Portal">
	<div class="space-y-12">
		<!-- Hero / Search Section -->
		<section class="text-center space-y-6 py-12">
			<h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl">
				Search your world, <span class="text-orange-600">powered by AI</span>.
			</h1>
			<p class="text-lg text-slate-600 max-w-2xl mx-auto">
				Ask questions, search indexed content, or paste a URL to crawl new data.
			</p>
			
			<div class="max-w-3xl mx-auto relative group">
				<form id="omnibar-form" class="relative">
					<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
						<Search class="h-5 w-5 text-slate-400 group-focus-within:text-orange-500 transition-colors" />
					</div>
					<input 
						type="text" 
						id="omnibar-input"
						autocomplete="off"
						placeholder="Ask anything, search, or paste a URL to crawl..." 
						class="block w-full pl-12 pr-12 py-6 bg-white text-slate-900 border border-slate-200 rounded-2xl shadow-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-all text-lg"
					/>
					<button 
						type="submit"
						class="absolute inset-y-2 right-2 px-3 bg-orange-600 hover:bg-orange-700 text-white rounded-xl flex items-center justify-center transition-colors"
					>
						<Send class="w-5 h-5" />
					</button>
				</form>
			</div>
		</section>

		<!-- Unified Results Area -->
		<div id="unified-container" class="max-w-4xl mx-auto space-y-8 hidden">
			
			<!-- Crawl Action UI -->
			<div id="crawl-action-ui" class="bg-orange-50 border border-orange-200 p-6 rounded-2xl hidden flex-col sm:flex-row items-center justify-between gap-4">
				<div class="flex items-center gap-3">
					<Globe class="w-6 h-6 text-orange-600" />
					<div>
						<h3 class="font-semibold text-orange-900">Looks like a URL!</h3>
						<p class="text-orange-700 text-sm">Do you want to crawl and index this page?</p>
					</div>
				</div>
				<button id="crawl-confirm-btn" class="px-6 py-2 bg-orange-600 text-white font-medium rounded-lg hover:bg-orange-700 transition-colors flex items-center gap-2">
					<span id="crawl-btn-text">Crawl & Index</span>
					<Loader2 id="crawl-loader" class="w-4 h-4 animate-spin hidden" />
				</button>
				<p id="crawl-status" class="text-sm font-medium hidden"></p>
			</div>

			<!-- AI Answer Area -->
			<div id="ai-answer-container" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 hidden">
				<div class="flex items-center gap-2 mb-4 border-b border-slate-100 pb-4">
					<Bot class="w-6 h-6 text-orange-600" />
					<h2 class="text-lg font-bold text-slate-900">AI Overview</h2>
				</div>
				<div id="ai-answer-content" class="prose prose-slate max-w-none text-slate-700">
					<p class="text-slate-400 italic animate-pulse flex items-center gap-2">
						<Loader2 class="w-4 h-4 animate-spin" /> Thinking...
					</p>
				</div>
			</div>

			<!-- Search Results Area -->
			<div id="search-results-container" class="space-y-4 hidden">
				<div class="flex items-center gap-2 mb-2">
					<Database class="w-5 h-5 text-slate-500" />
					<h2 class="text-lg font-semibold text-slate-800">Indexed Sources</h2>
				</div>
				<div id="search-results-list" class="grid gap-4">
					<!-- Results go here -->
				</div>
			</div>

		</div>
	</div>

	<script>
		const form = document.getElementById('omnibar-form');
		const input = document.getElementById('omnibar-input');
		const unifiedContainer = document.getElementById('unified-container');
		
		const crawlActionUi = document.getElementById('crawl-action-ui');
		const crawlConfirmBtn = document.getElementById('crawl-confirm-btn');
		const crawlBtnText = document.getElementById('crawl-btn-text');
		const crawlLoader = document.getElementById('crawl-loader');
		const crawlStatus = document.getElementById('crawl-status');
		
		const aiContainer = document.getElementById('ai-answer-container');
		const aiContent = document.getElementById('ai-answer-content');
		
		const searchContainer = document.getElementById('search-results-container');
		const searchList = document.getElementById('search-results-list');

		let currentCrawlUrl = '';

		const isUrl = (text) => {
			try {
				const url = new URL(text);
				return url.protocol === 'http:' || url.protocol === 'https:';
			} catch {
				return false;
			}
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const query = input.value.trim();
			if (!query) return;

			unifiedContainer.classList.remove('hidden');

			if (isUrl(query)) {
				// Show crawl UI
				crawlActionUi.classList.remove('hidden');
				aiContainer.classList.add('hidden');
				searchContainer.classList.add('hidden');
				
				// Reset crawl UI
				currentCrawlUrl = query;
				crawlConfirmBtn.classList.remove('hidden');
				crawlConfirmBtn.disabled = false;
				crawlStatus.classList.add('hidden');
				crawlStatus.textContent = '';
				crawlBtnText.textContent = 'Crawl & Index';
			} else {
				// Hide crawl UI, show AI & Search
				crawlActionUi.classList.add('hidden');
				aiContainer.classList.remove('hidden');
				searchContainer.classList.remove('hidden');

				// Set loading states
				aiContent.innerHTML = `<p class="text-slate-400 italic animate-pulse flex items-center gap-2">
					<svg class="w-4 h-4 animate-spin lucide lucide-loader-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg> 
					Thinking...
				</p>`;
				searchList.innerHTML = `<div class="p-4 bg-white border border-slate-100 rounded-xl shadow-sm text-slate-400 italic animate-pulse">Searching documents...</div>`;

				// 1. Fetch AI Answer
				fetch('/api/chat', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ message: query })
				})
				.then(res => res.json())
				.then(data => {
					if (data.answer) {
						aiContent.innerHTML = `<p>${data.answer.replace(/\n/g, '<br/>')}</p>`;
					} else {
						aiContent.innerHTML = `<p class="text-red-500">Failed to get an AI response.</p>`;
					}
				})
				.catch(err => {
					aiContent.innerHTML = `<p class="text-red-500">Error connecting to AI: ${err.message}</p>`;
				});

				// 2. Fetch Search Results
				fetch(`/api/search?q=${encodeURIComponent(query)}`)
				.then(res => res.json())
				.then(data => {
					const results = data.results || [];
					if (results.length > 0) {
						searchList.innerHTML = results.map(r => `
							<div class="p-4 bg-white border border-slate-200 rounded-xl hover:border-orange-300 transition-colors shadow-sm">
								<a href="${r.url}" target="_blank" class="text-orange-600 font-medium hover:underline block mb-2 text-lg">${r.title}</a>
								<p class="text-sm text-slate-600 leading-relaxed">${r.snippet}</p>
								<span class="text-xs text-slate-400 mt-3 block flex items-center gap-1">
									<svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
									${r.url}
								</span>
							</div>
						`).join('');
					} else {
						searchList.innerHTML = `<p class="text-slate-500 italic p-4 bg-white rounded-xl border border-slate-100">No matching documents found.</p>`;
					}
				})
				.catch(err => {
					searchList.innerHTML = `<p class="text-red-500 italic p-4 bg-white rounded-xl border border-red-100">Search error: ${err.message}</p>`;
				});
			}
		});

		// Crawl button logic
		crawlConfirmBtn.addEventListener('click', async () => {
			if (!currentCrawlUrl) return;

			crawlConfirmBtn.disabled = true;
			crawlLoader.classList.remove('hidden');
			crawlBtnText.textContent = 'Crawling...';
			
			crawlStatus.classList.remove('hidden');
			crawlStatus.textContent = 'Extracting content...';
			crawlStatus.className = 'text-sm font-medium text-orange-600 animate-pulse';

			try {
				const res = await fetch('/api/crawl', {
					method: 'POST',
					body: JSON.stringify({ url: currentCrawlUrl }),
					headers: { 'Content-Type': 'application/json' }
				});
				const data = await res.json();
				
				crawlLoader.classList.add('hidden');
				crawlConfirmBtn.classList.add('hidden');

				if (data.success) {
					crawlStatus.textContent = `✅ Successfully indexed: ${data.title}`;
					crawlStatus.className = 'text-sm font-medium text-green-600';
					setTimeout(() => {
						input.value = '';
					}, 2000);
				} else {
					throw new Error(data.error || 'Failed to crawl');
				}
			} catch (err) {
				crawlLoader.classList.add('hidden');
				crawlConfirmBtn.disabled = false;
				crawlBtnText.textContent = 'Retry Crawl';
				
				crawlStatus.textContent = `❌ Error: ${err.message}`;
				crawlStatus.className = 'text-sm font-medium text-red-600';
			}
		});
	</script>
</Layout>
