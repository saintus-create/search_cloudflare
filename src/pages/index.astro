---
import Layout from '../layouts/Layout.astro';
import { Search, Send, Globe, Loader2, Bot } from '@lucide/astro';
---

<Layout title="CloudSearch - AI Portal">
	<div class="space-y-12">
		<!-- Hero / Search Section -->
		<section class="text-center space-y-6 py-12">
			<h1 class="text-4xl font-extrabold tracking-tight text-slate-900 sm:text-6xl">
				Search your world, <span class="text-orange-600">powered by AI</span>.
			</h1>
			<p class="text-lg text-slate-600 max-w-2xl mx-auto">
				Crawl any website, index it with Cloudflare D1, and chat with your data using Workers AI.
			</p>
			
			<div class="max-w-2xl mx-auto relative group">
				<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
					<Search class="h-5 w-5 text-slate-400 group-focus-within:text-orange-500 transition-colors" />
				</div>
				<input 
					type="text" 
					id="search-input"
					placeholder="Search indexed content..." 
					class="block w-full pl-12 pr-4 py-6 bg-white text-slate-900 border border-slate-200 rounded-2xl shadow-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-all text-lg"
				/>
			</div>
		</section>

		<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
			<!-- Left Column: Search Results & Crawler -->
			<div class="lg:col-span-2 space-y-8">
				<!-- Crawler Section -->
				<div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
					<h2 class="text-lg font-semibold flex items-center gap-2">
						<Globe class="w-5 h-5 text-orange-600" />
						Index New URL
					</h2>
					<div class="flex gap-2">
						<input 
							type="url" 
							id="crawl-url"
							placeholder="https://example.com" 
							class="flex-1 px-4 py-2 bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none"
						/>
						<button 
							id="crawl-btn"
							class="px-4 py-2 bg-orange-600 text-white font-medium rounded-lg hover:bg-orange-700 transition-colors flex items-center gap-2 disabled:opacity-50"
						>
							<span id="crawl-text">Crawl</span>
							<Loader2 id="crawl-loader" class="w-4 h-4 animate-spin hidden" />
						</button>
					</div>
					<p id="crawl-status" class="text-sm text-slate-500 hidden"></p>
				</div>

				<!-- Search Results -->
				<div id="results-container" class="space-y-4 hidden">
					<h2 class="text-lg font-semibold">Search Results</h2>
					<div id="results-list" class="space-y-4">
						<!-- Results will be injected here -->
					</div>
				</div>
			</div>

			<!-- Right Column: AI Chat -->
			<div class="space-y-4">
				<div id="chat" class="bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col h-[600px]">
					<div class="p-4 border-b border-slate-100 flex items-center gap-2 font-semibold">
						<Bot class="w-5 h-5 text-orange-600" />
						AI Assistant
					</div>
					<div id="chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4 text-sm">
						<div class="bg-slate-50 p-3 rounded-lg text-slate-600">
							Ask me anything about your indexed documents!
						</div>
					</div>
					<div class="p-4 border-t border-slate-100">
						<div class="relative">
							<input 
								type="text" 
								id="chat-input"
								placeholder="Ask a question..." 
								class="w-full pl-4 pr-10 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none"
							/>
							<button 
								id="chat-send"
								class="absolute right-2 top-1/2 -translate-y-1/2 text-orange-600 hover:text-orange-700"
							>
								<Send class="w-5 h-5" />
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script>
		// --- Crawler Logic ---
		const crawlBtn = document.getElementById('crawl-btn');
		const crawlUrl = document.getElementById('crawl-url');
		const crawlStatus = document.getElementById('crawl-status');
		const crawlLoader = document.getElementById('crawl-loader');
		const crawlText = document.getElementById('crawl-text');

		crawlBtn?.addEventListener('click', async () => {
			const url = crawlUrl.value;
			if (!url) return;

			crawlBtn.disabled = true;
			crawlLoader.classList.remove('hidden');
			crawlText.classList.add('hidden');
			crawlStatus.classList.remove('hidden');
			crawlStatus.textContent = 'Crawling and indexing...';

			try {
				const res = await fetch('/api/crawl', {
					method: 'POST',
					body: JSON.stringify({ url }),
					headers: { 'Content-Type': 'application/json' }
				});
				const data = await res.json();
				if (data.success) {
					crawlStatus.textContent = `Successfully indexed: ${data.title}`;
					crawlStatus.className = 'text-sm text-green-600';
				} else {
					throw new Error(data.error);
				}
			} catch (err) {
				crawlStatus.textContent = `Error: ${err.message}`;
				crawlStatus.className = 'text-sm text-red-600';
			} finally {
				crawlBtn.disabled = false;
				crawlLoader.classList.add('hidden');
				crawlText.classList.remove('hidden');
			}
		});

		// --- Search Logic ---
		const searchInput = document.getElementById('search-input');
		const resultsContainer = document.getElementById('results-container');
		const resultsList = document.getElementById('results-list');

		let searchTimeout;
		searchInput?.addEventListener('input', (e) => {
			clearTimeout(searchTimeout);
			searchTimeout = setTimeout(async () => {
				const q = e.target.value;
				if (q.length < 2) {
					resultsContainer.classList.add('hidden');
					return;
				}

				const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
				const { results } = await res.json();

				resultsContainer.classList.remove('hidden');
				resultsList.innerHTML = results.length > 0 
					? results.map(r => `
						<div class="p-4 bg-white border border-slate-100 rounded-xl hover:border-orange-200 transition-colors shadow-sm">
							<a href="${r.url}" target="_blank" class="text-orange-600 font-medium hover:underline block mb-1">${r.title}</a>
							<p class="text-sm text-slate-600">${r.snippet}</p>
							<span class="text-xs text-slate-400 mt-2 block">${r.url}</span>
						</div>
					`).join('')
					: '<p class="text-slate-500 italic">No results found.</p>';
			}, 300);
		});

		// --- Chat Logic ---
		const chatInput = document.getElementById('chat-input');
		const chatSend = document.getElementById('chat-send');
		const chatMessages = document.getElementById('chat-messages');

		const addMessage = (text, isUser = false) => {
			const div = document.createElement('div');
			div.className = isUser 
				? 'bg-orange-600 text-white p-3 rounded-lg ml-8 self-end' 
				: 'bg-slate-100 text-slate-800 p-3 rounded-lg mr-8';
			div.textContent = text;
			chatMessages?.appendChild(div);
			chatMessages.scrollTop = chatMessages.scrollHeight;
		};

		const handleChat = async () => {
			const message = chatInput.value;
			if (!message) return;

			chatInput.value = '';
			addMessage(message, true);

			const loadingDiv = document.createElement('div');
			loadingDiv.className = 'text-slate-400 italic text-xs animate-pulse';
			loadingDiv.textContent = 'AI is thinking...';
			chatMessages?.appendChild(loadingDiv);

			try {
				const res = await fetch('/api/chat', {
					method: 'POST',
					body: JSON.stringify({ message }),
					headers: { 'Content-Type': 'application/json' }
				});
				const data = await res.json();
				loadingDiv.remove();
				addMessage(data.answer);
			} catch (err) {
				loadingDiv.remove();
				addMessage('Sorry, something went wrong.');
			}
		};

		chatSend?.addEventListener('click', handleChat);
		chatInput?.addEventListener('keypress', (e) => {
			if (e.key === 'Enter') handleChat();
		});
	</script>
</Layout>
