---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CloudSearch">
  <header class="sticky top-0 z-40 border-b bg-[var(--surface)]/95 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <a href="/" class="flex items-center gap-3 font-semibold tracking-tight" aria-label="CloudSearch home">
        <span class="grid size-9 place-items-center rounded-xl bg-[var(--accent)] text-white shadow-sm">C</span>
        <span>CloudSearch</span>
      </a>
      <div class="flex items-center gap-2">
        <button id="theme-toggle" type="button" class="grid size-9 place-items-center rounded-lg border bg-transparent hover:bg-slate-100 dark:hover:bg-slate-800" aria-label="Toggle theme">
          <span aria-hidden="true">◐</span>
        </button>
        <button id="upload-button" type="button" class="inline-flex h-9 items-center gap-2 rounded-lg bg-[var(--accent)] px-4 text-sm font-medium text-white shadow-sm hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
          <span aria-hidden="true">↑</span> Upload
        </button>
      </div>
    </div>
  </header>

  <main class="mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section class="mx-auto max-w-3xl text-center">
      <div class="mb-4 inline-flex items-center rounded-full border bg-[var(--surface)] px-3 py-1 text-xs font-medium muted">Evidence-grounded search</div>
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Find the evidence.</h1>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-7 muted">Search your indexed documents, inspect sources, or ask a question grounded in the material you have stored.</p>

      <form id="search-form" class="relative mt-8">
        <div class="flex rounded-2xl border bg-[var(--surface)] p-2 shadow-lg shadow-slate-200/40 focus-within:ring-2 focus-within:ring-blue-500/30 dark:shadow-none">
          <label for="search-input" class="sr-only">Search documents</label>
          <input id="search-input" type="search" autocomplete="off" placeholder="Search documents or paste a URL…" class="min-w-0 flex-1 border-0 bg-transparent px-4 py-3 text-base outline-none focus:ring-0" />
          <button id="search-button" type="submit" class="inline-flex items-center gap-2 rounded-xl bg-[var(--accent)] px-5 py-3 text-sm font-semibold text-white hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60">Search</button>
        </div>
        <div id="suggestions-box" class="absolute left-0 right-0 top-full z-30 mt-2 hidden overflow-hidden rounded-xl border bg-[var(--surface)] text-left shadow-xl"></div>
      </form>

      <div class="mt-5 flex flex-wrap justify-center gap-2 text-xs muted">
        <span class="rounded-full border px-3 py-1">Full-text search</span>
        <span class="rounded-full border px-3 py-1">Source citations</span>
        <span class="rounded-full border px-3 py-1">URL ingestion</span>
        <span class="rounded-full border px-3 py-1">AI synthesis</span>
      </div>
    </section>

    <section id="loading-state" class="mx-auto mt-12 hidden max-w-4xl" aria-live="polite">
      <div class="space-y-3 animate-pulse"><div class="h-5 w-40 rounded bg-slate-200 dark:bg-slate-800"></div><div class="h-24 rounded-2xl bg-slate-200 dark:bg-slate-800"></div><div class="h-24 rounded-2xl bg-slate-200 dark:bg-slate-800"></div></div>
    </section>

    <section id="crawl-status" class="mx-auto mt-8 hidden max-w-4xl" aria-live="polite">
      <div class="flex items-center gap-3 rounded-xl border bg-[var(--surface)] p-4"><span class="grid size-8 place-items-center rounded-full bg-blue-50 text-blue-600 dark:bg-blue-950">↻</span><div><p class="font-medium">Indexing URL</p><p id="crawl-message" class="text-sm muted">Extracting content…</p></div></div>
    </section>

    <section id="results-area" class="mx-auto mt-12 hidden max-w-4xl">
      <div class="grid gap-8 lg:grid-cols-[1fr_320px]">
        <div>
          <div class="mb-4 flex items-center justify-between"><h2 class="text-sm font-semibold uppercase tracking-wider muted">Sources</h2><span id="result-count" class="text-xs muted"></span></div>
          <div id="citations-list" class="space-y-3"></div>
        </div>
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <div class="rounded-2xl border bg-[var(--surface)] p-5 shadow-sm">
            <div class="mb-3 flex items-center gap-2"><span class="grid size-7 place-items-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-950">✦</span><h2 class="font-semibold">AI synthesis</h2></div>
            <div id="ai-content" class="text-sm leading-6 muted">Search to generate an evidence-grounded synthesis.</div>
          </div>
        </aside>
      </div>
    </section>

    <section id="empty-state" class="mx-auto mt-16 max-w-xl text-center">
      <div class="mx-auto grid size-12 place-items-center rounded-2xl border bg-[var(--surface)] text-xl">⌕</div>
      <h2 class="mt-4 font-semibold">Your research workspace</h2>
      <p class="mt-2 text-sm leading-6 muted">Upload a document or search the indexed corpus. Results stay tied to their underlying sources.</p>
    </section>
  </main>
</Layout>

<script type="module">
  const form = document.getElementById('search-form');
  const input = document.getElementById('search-input');
  const button = document.getElementById('search-button');
  const suggestions = document.getElementById('suggestions-box');
  const loading = document.getElementById('loading-state');
  const results = document.getElementById('results-area');
  const empty = document.getElementById('empty-state');
  const sources = document.getElementById('citations-list');
  const answer = document.getElementById('ai-content');
  const count = document.getElementById('result-count');
  const crawl = document.getElementById('crawl-status');
  const crawlMessage = document.getElementById('crawl-message');

  const isUrl = (value) => { try { const url = new URL(value); return ['http:', 'https:'].includes(url.protocol); } catch { return false; } };
  const setBusy = (busy) => { button.disabled = busy; input.disabled = busy; button.textContent = busy ? 'Searching…' : 'Search'; loading.classList.toggle('hidden', !busy); };

  const renderSources = (items) => {
    sources.replaceChildren();
    count.textContent = `${items.length} result${items.length === 1 ? '' : 's'}`;
    for (const item of items) {
      const card = document.createElement('article');
      card.className = 'rounded-2xl border bg-[var(--surface)] p-5 shadow-sm transition hover:shadow-md';
      const title = document.createElement('h3');
      title.className = 'font-semibold';
      title.textContent = item.title || 'Untitled document';
      const meta = document.createElement('p');
      meta.className = 'mt-1 text-xs muted';
      meta.textContent = item.url || 'Indexed document';
      const snippet = document.createElement('p');
      snippet.className = 'mt-3 text-sm leading-6 muted';
      snippet.textContent = item.snippet || 'No excerpt available.';
      card.append(title, meta, snippet);
      sources.appendChild(card);
    }
  };

  let suggestionTimer;
  input.addEventListener('input', () => {
    clearTimeout(suggestionTimer);
    const value = input.value.trim();
    if (value.length < 2 || isUrl(value)) { suggestions.classList.add('hidden'); return; }
    suggestionTimer = setTimeout(async () => {
      try {
        const response = await fetch(`/api/suggest?q=${encodeURIComponent(value)}`);
        const items = await response.json();
        suggestions.replaceChildren();
        for (const item of Array.isArray(items) ? items.slice(0, 6) : []) {
          const option = document.createElement('button');
          option.type = 'button'; option.className = 'block w-full border-b px-4 py-3 text-left text-sm last:border-0 hover:bg-slate-50 dark:hover:bg-slate-800'; option.textContent = item;
          option.addEventListener('click', () => { input.value = item; suggestions.classList.add('hidden'); form.requestSubmit(); });
          suggestions.appendChild(option);
        }
        suggestions.classList.toggle('hidden', !suggestions.children.length);
      } catch { suggestions.classList.add('hidden'); }
    }, 250);
  });

  document.addEventListener('click', (event) => { if (!suggestions.contains(event.target) && event.target !== input) suggestions.classList.add('hidden'); });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const query = input.value.trim();
    if (!query) return;
    suggestions.classList.add('hidden'); empty.classList.add('hidden'); results.classList.add('hidden'); crawl.classList.add('hidden'); setBusy(true);
    try {
      if (isUrl(query)) {
        crawl.classList.remove('hidden');
        const response = await fetch('/api/crawl', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: query }) });
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.error || 'Unable to index URL.');
        crawlMessage.textContent = `Indexed successfully: ${data.title || query}`;
        return;
      }
      const [searchResponse, chatResponse] = await Promise.all([
        fetch(`/api/search?q=${encodeURIComponent(query)}`),
        fetch('/api/chat', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ message: query }) })
      ]);
      const searchData = await searchResponse.json();
      const chatData = await chatResponse.json();
      if (!searchResponse.ok) throw new Error(searchData.error || 'Search failed.');
      renderSources(Array.isArray(searchData.results) ? searchData.results : []);
      answer.textContent = chatData.answer || 'No synthesis was returned.';
      results.classList.remove('hidden');
    } catch (error) {
      answer.textContent = error instanceof Error ? error.message : 'Something went wrong.';
      results.classList.remove('hidden');
      sources.replaceChildren(); count.textContent = '';
    } finally {
      setBusy(false);
    }
  });

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    localStorage.setItem('cloudsearch-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
  });
</script>
