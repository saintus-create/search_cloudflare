---
import Layout from '../layouts/Layout.astro';
import { Search, Send, Globe, Loader2, Sparkles, Database } from '@lucide/astro';
---

<Layout title="CloudSearch - Unified AI Portal">
	<div class="flex flex-col items-center justify-center min-h-[50vh] space-y-12">
		
		<!-- Hero / Search Section -->
		<section class="w-full text-center space-y-10">
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-light tracking-tight text-gray-900 drop-shadow-sm">
				What are you looking for?
			</h1>
			
			<div class="max-w-2xl mx-auto relative group w-full">
				<form id="omnibar-form" class="relative flex items-center group">
					<div class="absolute inset-y-0 left-0 pl-6 flex items-center pointer-events-none">
						<Search class="h-5 w-5 text-gray-300 group-focus-within:gradient-icon transition-all duration-500 ease-out" />
					</div>
					<input 
						type="text" 
						id="omnibar-input"
						autocomplete="off"
						placeholder="Ask a question, search documents, or enter a URL..." 
						class="block w-full pl-14 pr-16 py-5 bg-white/90 backdrop-blur-sm text-gray-900 border border-gray-200/80 rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.04),0_1px_3px_rgb(0,0,0,0.02)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.06),0_1px_3px_rgb(0,0,0,0.03)] focus:shadow-[0_8px_30px_rgb(0,0,0,0.08),0_1px_3px_rgb(0,0,0,0.04)] focus:ring-1 focus:ring-gray-100 focus:border-gray-300 outline-none transition-all duration-300 text-lg font-light placeholder:text-gray-400 placeholder:font-light"
					/>
					<button 
						type="submit"
						class="absolute inset-y-2 right-2 px-4 bg-gray-900 hover:bg-black text-white rounded-full flex items-center justify-center transition-all duration-200 active:scale-95"
					>
						<Send class="w-4 h-4" />
					</button>
				</form>
			</div>
		</section>

		<!-- Unified Results Area -->
		<div id="unified-container" class="w-full max-w-3xl space-y-12 hidden text-left pb-16">
			
			<!-- Crawl Action UI -->
			<div id="crawl-action-ui" class="bg-gray-50/80 border border-gray-100/80 p-6 rounded-3xl hidden flex-col sm:flex-row items-center justify-between gap-4 backdrop-blur-sm animate-fade-in-up">
				<div class="flex items-center gap-5">
					<div class="p-3.5 bg-white rounded-full shadow-sm border border-gray-100">
						<Globe class="w-6 h-6 gradient-icon" />
					</div>
					<div>
						<h3 class="font-medium text-gray-900 text-lg tracking-tight">External Link Detected</h3>
						<p class="text-gray-500 text-sm font-light mt-0.5">Would you like to securely index this page into the database?</p>
					</div>
				</div>
				<div class="flex flex-col items-end gap-2">
					<button id="crawl-confirm-btn" class="px-6 py-2.5 bg-gray-900 text-white text-sm font-medium rounded-full hover:bg-black transition-all active:scale-95 flex items-center gap-2 shadow-sm">
						<span id="crawl-btn-text">Index Link</span>
						<Loader2 id="crawl-loader" class="w-4 h-4 animate-spin hidden" />
					</button>
					<p id="crawl-status" class="text-xs font-medium hidden text-right"></p>
				</div>
			</div>

			<!-- AI Answer Area -->
			<div id="ai-answer-container" class="hidden space-y-5 animate-fade-in-up" style="animation-delay: 100ms;">
				<div class="flex items-center gap-2">
					<Sparkles class="w-4 h-4 gradient-icon" />
					<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-[0.15em]">AI Synthesis</h2>
				</div>
				<div id="ai-answer-content" class="text-gray-800 font-light text-lg leading-relaxed prose prose-slate max-w-none">
					<!-- Elegant Skeleton Loader -->
					<div class="animate-pulse-subtle space-y-3 pt-2">
						<div class="h-4 bg-gray-200/60 rounded-full w-3/4"></div>
						<div class="h-4 bg-gray-200/60 rounded-full w-full"></div>
						<div class="h-4 bg-gray-200/60 rounded-full w-5/6"></div>
					</div>
				</div>
			</div>

			<!-- Search Results Area -->
			<div id="search-results-container" class="hidden space-y-6 pt-10 border-t border-gray-100/60 animate-fade-in-up" style="animation-delay: 250ms;">
				<div class="flex items-center gap-2 mb-2">
					<Database class="w-4 h-4 text-gray-400" />
					<h2 class="text-xs font-semibold text-gray-400 uppercase tracking-[0.15em]">Sourced Documents</h2>
				</div>
				<div id="search-results-list" class="grid gap-8">
					<!-- Results go here -->
				</div>
			</div>

		</div>
	</div>

	<script>
		const form = document.getElementById('omnibar-form');
		const input = document.getElementById('omnibar-input');
		const unifiedContainer = document.getElementById('unified-container');
		
		const crawlActionUi = document.getElementById('crawl-action-ui');
		const crawlConfirmBtn = document.getElementById('crawl-confirm-btn');
		const crawlBtnText = document.getElementById('crawl-btn-text');
		const crawlLoader = document.getElementById('crawl-loader');
		const crawlStatus = document.getElementById('crawl-status');
		
		const aiContainer = document.getElementById('ai-answer-container');
		const aiContent = document.getElementById('ai-answer-content');
		
		const searchContainer = document.getElementById('search-results-container');
		const searchList = document.getElementById('search-results-list');

		let currentCrawlUrl = '';

		const isUrl = (text) => {
			try {
				const url = new URL(text);
				return url.protocol === 'http:' || url.protocol === 'https:';
			} catch {
				return false;
			}
		};

		// Utility to perfectly re-trigger CSS animations on submit
		const resetAnimation = (el) => {
			el.style.animation = 'none';
			el.offsetHeight; // trigger reflow
			el.style.animation = null;
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const query = input.value.trim();
			if (!query) return;

			unifiedContainer.classList.remove('hidden');

			if (isUrl(query)) {
				crawlActionUi.classList.remove('hidden');
				aiContainer.classList.add('hidden');
				searchContainer.classList.add('hidden');
				
				resetAnimation(crawlActionUi);

				currentCrawlUrl = query;
				crawlConfirmBtn.classList.remove('hidden');
				crawlConfirmBtn.disabled = false;
				crawlStatus.classList.add('hidden');
				crawlStatus.textContent = '';
				crawlBtnText.textContent = 'Index Link';
			} else {
				crawlActionUi.classList.add('hidden');
				aiContainer.classList.remove('hidden');
				searchContainer.classList.remove('hidden');

				resetAnimation(aiContainer);
				resetAnimation(searchContainer);

				// Reset to skeleton loaders
				aiContent.innerHTML = `
					<div class="animate-pulse-subtle space-y-3 pt-2">
						<div class="h-4 bg-gray-200/60 rounded-full w-3/4"></div>
						<div class="h-4 bg-gray-200/60 rounded-full w-full"></div>
						<div class="h-4 bg-gray-200/60 rounded-full w-5/6"></div>
					</div>`;
					
				searchList.innerHTML = `
					<div class="animate-pulse-subtle space-y-6 pt-2">
						<div>
							<div class="h-5 bg-gray-200/60 rounded-full w-1/3 mb-3"></div>
							<div class="h-3 bg-gray-100 rounded-full w-full mb-2"></div>
							<div class="h-3 bg-gray-100 rounded-full w-4/5"></div>
						</div>
					</div>`;

				// Fetch AI Answer
				fetch('/api/chat', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ message: query })
				})
				.then(res => res.json())
				.then(data => {
					if (data.answer) {
						// Using prose formats it beautifully
						aiContent.innerHTML = `<p>${data.answer.replace(/\n/g, '<br/>')}</p>`;
					} else {
						aiContent.innerHTML = `<p class="text-gray-400 italic">No response generated.</p>`;
					}
				})
				.catch(err => {
					aiContent.innerHTML = `<p class="text-gray-400 italic">Error connecting to AI: ${err.message}</p>`;
				});

				// Fetch Search Results
				fetch(`/api/search?q=${encodeURIComponent(query)}`)
				.then(res => res.json())
				.then(data => {
					const results = data.results || [];
					if (results.length > 0) {
						searchList.innerHTML = results.map(r => `
							<div class="group cursor-pointer">
								<a href="${r.url}" target="_blank" class="text-gray-900 font-medium group-hover:text-gray-600 transition-colors block mb-1.5 text-lg tracking-tight">${r.title}</a>
								<p class="text-[0.95rem] text-gray-500 font-light leading-relaxed mb-3">${r.snippet}</p>
								<span class="text-[0.65rem] text-gray-400 flex items-center gap-1.5 uppercase tracking-widest font-medium">
									<svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
									${r.url}
								</span>
							</div>
						`).join('');
					} else {
						searchList.innerHTML = `<p class="text-gray-400 italic font-light">No matching documents found.</p>`;
					}
				})
				.catch(err => {
					searchList.innerHTML = `<p class="text-gray-400 italic font-light">Search error: ${err.message}</p>`;
				});
			}
		});

		// Crawl Action Logic
		crawlConfirmBtn.addEventListener('click', async () => {
			if (!currentCrawlUrl) return;

			crawlConfirmBtn.disabled = true;
			crawlLoader.classList.remove('hidden');
			crawlBtnText.textContent = 'Indexing...';
			
			crawlStatus.classList.remove('hidden');
			crawlStatus.textContent = 'Extracting content...';
			crawlStatus.className = 'text-xs font-medium text-gray-400 animate-pulse mt-3 text-right';

			try {
				const res = await fetch('/api/crawl', {
					method: 'POST',
					body: JSON.stringify({ url: currentCrawlUrl }),
					headers: { 'Content-Type': 'application/json' }
				});
				const data = await res.json();
				
				crawlLoader.classList.add('hidden');
				crawlConfirmBtn.classList.add('hidden');

				if (data.success) {
					crawlStatus.textContent = `Indexed securely: ${data.title}`;
					crawlStatus.className = 'text-xs font-medium text-gray-900 mt-3 text-right';
					crawlStatus.classList.remove('animate-pulse');
					setTimeout(() => {
						input.value = '';
					}, 2500);
				} else {
					throw new Error(data.error || 'Failed to crawl');
				}
			} catch (err) {
				crawlLoader.classList.add('hidden');
				crawlConfirmBtn.disabled = false;
				crawlBtnText.textContent = 'Retry';
				
				crawlStatus.textContent = `Error: ${err.message}`;
				crawlStatus.className = 'text-xs font-medium text-gray-400 mt-3 text-right';
				crawlStatus.classList.remove('animate-pulse');
			}
		});
	</script>
</Layout>
